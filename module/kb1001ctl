#!/system/bin/sh
MODDIR=${0%/*}
. "$MODDIR/common.sh"

AUTO_CONF="$STATE_DIR/auto_boost.conf"
GAMES="$STATE_DIR/games.list"
AUTO_PID="/data/local/tmp/kb1001_game_boost.pid"
AUTO_STATE="/data/local/tmp/kb1001_game_boost.state"

ensure_configs() {
    mkdir -p "$STATE_DIR"
    [ -f "$CONFIG" ] || echo dynamic744 > "$CONFIG"
    if [ ! -f "$AUTO_CONF" ]; then
        cat > "$AUTO_CONF" <<EOC
# KB1001 automatic game boost
enabled=0
game_profile=performance744
idle_profile=dynamic744
poll_seconds=2
EOC
    fi
    [ -f "$GAMES" ] || : > "$GAMES"
}

set_conf() {
    key="$1"; value="$2"
    tmp="$AUTO_CONF.tmp.$$"
    grep -v "^${key}=" "$AUTO_CONF" 2>/dev/null > "$tmp"
    echo "${key}=${value}" >> "$tmp"
    mv "$tmp" "$AUTO_CONF"
}

get_conf() {
    key="$1"; def="$2"
    value="$(grep -m1 "^${key}=" "$AUTO_CONF" 2>/dev/null | cut -d= -f2-)"
    [ -n "$value" ] && echo "$value" || echo "$def"
}

valid_package() {
    case "$1" in
        ''|*[!A-Za-z0-9._-]*) return 1 ;;
        *.*) return 0 ;;
        *) return 1 ;;
    esac
}

start_daemon() {
    pid="$(cat "$AUTO_PID" 2>/dev/null)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        echo "AutoBoost daemon already running (pid $pid)."
        return 0
    fi
    rm -f "$AUTO_PID"
    nohup "$MODDIR/game_boost.sh" --daemon >/dev/null 2>&1 &
    sleep 1
    pid="$(cat "$AUTO_PID" 2>/dev/null)"
    [ -n "$pid" ] && echo "AutoBoost daemon started (pid $pid)." || echo "AutoBoost daemon start requested."
}

stop_daemon() {
    pid="$(cat "$AUTO_PID" 2>/dev/null)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        kill "$pid" 2>/dev/null
        i=0
        while kill -0 "$pid" 2>/dev/null && [ $i -lt 10 ]; do sleep 1; i=$((i+1)); done
    fi
    rm -f "$AUTO_PID" "$AUTO_STATE"
}

status() {
    echo "KB1001 Performance Manager"
    echo "Persistent profile: $(cat "$CONFIG" 2>/dev/null)"
    echo "Auto boost:         $(get_conf enabled 0)"
    echo "Game profile:       $(get_conf game_profile performance744)"
    echo "Idle profile:       $(get_conf idle_profile dynamic744)"
    echo "Poll seconds:       $(get_conf poll_seconds 2)"
    echo "Registered games:   $(grep -Ev '^[[:space:]]*(#|$)' "$GAMES" 2>/dev/null | wc -l)"
    pid="$(cat "$AUTO_PID" 2>/dev/null)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        echo "Auto daemon:        running (pid $pid)"
    else
        echo "Auto daemon:        stopped"
    fi
    if [ -f "$AUTO_STATE" ]; then
        echo "--- Auto state ---"
        cat "$AUTO_STATE"
    fi
    if [ -f "$SESSION_EXTREME" ]; then
        echo "Session override:   Extreme 792 ACTIVE"
    fi
    echo "--- GPU ---"
    show_status
}

ensure_configs

cmd="$1"
shift 2>/dev/null || true
case "$cmd" in
    status) status ;;
    apply)
        profile="$1"
        case "$profile" in
            stock|dynamic744|performance744) apply_profile "$profile" 120 ;;
            extreme792) echo dynamic744 > "$CONFIG"; apply_profile extreme792 120 ;;
            *) echo "Usage: kb1001ctl apply stock|dynamic744|performance744|extreme792" >&2; exit 2 ;;
        esac
        ;;
    persist)
        profile="$1"
        case "$profile" in
            stock|dynamic744|performance744) echo "$profile" > "$CONFIG"; apply_profile "$profile" 120 ;;
            *) echo "Extreme 792 cannot be persisted." >&2; exit 2 ;;
        esac
        ;;
    auto)
        sub="$1"; value="$2"
        case "$sub" in
            enable)
                set_conf enabled 1
                idle="$(get_conf idle_profile dynamic744)"
                apply_profile "$idle" 120 || true
                start_daemon
                ;;
            disable)
                set_conf enabled 0
                stop_daemon
                restore="$(cat "$CONFIG" 2>/dev/null)"
                case "$restore" in stock|dynamic744|performance744) ;; *) restore=dynamic744 ;; esac
                apply_profile "$restore" 120
                ;;
            profile)
                case "$value" in
                    dynamic744|performance744) set_conf game_profile "$value" ;;
                    extreme792) echo "Extreme 792 is blocked for unattended auto boost." >&2; exit 2 ;;
                    *) echo "Use: auto profile dynamic744|performance744" >&2; exit 2 ;;
                esac
                ;;
            idle)
                case "$value" in
                    stock|dynamic744|performance744) set_conf idle_profile "$value" ;;
                    *) echo "Use: auto idle stock|dynamic744|performance744" >&2; exit 2 ;;
                esac
                ;;
            poll)
                case "$value" in ''|*[!0-9]*) echo "Poll must be 1-10 seconds." >&2; exit 2 ;; esac
                [ "$value" -ge 1 ] && [ "$value" -le 10 ] || { echo "Poll must be 1-10 seconds." >&2; exit 2; }
                set_conf poll_seconds "$value"
                ;;
            start) start_daemon ;;
            stop) stop_daemon ;;
            *) echo "Usage: kb1001ctl auto enable|disable|profile <...>|idle <...>|poll <1-10>|start|stop" >&2; exit 2 ;;
        esac
        ;;
    game)
        sub="$1"; pkg="$2"
        case "$sub" in
            list) grep -Ev '^[[:space:]]*(#|$)' "$GAMES" 2>/dev/null || true ;;
            add)
                valid_package "$pkg" || { echo "Invalid package name." >&2; exit 2; }
                grep -Fxq "$pkg" "$GAMES" 2>/dev/null || echo "$pkg" >> "$GAMES"
                ;;
            remove)
                valid_package "$pkg" || { echo "Invalid package name." >&2; exit 2; }
                tmp="$GAMES.tmp.$$"
                grep -Fvx "$pkg" "$GAMES" 2>/dev/null > "$tmp" || true
                mv "$tmp" "$GAMES"
                ;;
            clear) : > "$GAMES" ;;
            *) echo "Usage: kb1001ctl game list|add <package>|remove <package>|clear" >&2; exit 2 ;;
        esac
        ;;
    foreground) "$MODDIR/game_boost.sh" foreground ;;
    *)
        cat <<EOH
KB1001 Performance Manager controller

Commands:
  status
  apply stock|dynamic744|performance744|extreme792
  persist stock|dynamic744|performance744
  auto enable|disable
  auto profile dynamic744|performance744
  auto idle stock|dynamic744|performance744
  auto poll 1..10
  game list|add <package>|remove <package>|clear
  foreground
EOH
        ;;
esac
